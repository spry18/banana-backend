{
  "info": {
    "name": "Billing Module — Banana Transport",
    "_postman_id": "billing-module-v1",
    "description": "Complete API collection for the isolated Billing Module (src/modules/billing/). All routes are prefixed with /api/billing. All requests require Bearer token authentication (Admin role).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_ADMIN_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "farmer_bill_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "company_bill_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "farmer_payment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "company_payment_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "eicher_trip_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "munshi_entry_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "kharchi_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "pickup_trip_id",
      "value": "",
      "type": "string"
